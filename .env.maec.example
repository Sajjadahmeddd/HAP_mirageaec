# MAEC (HAPExt / AirSizer / Rebadging) container configuration.
#
# Named .env.maec — NOT .env — because the repository root .env belongs to
# the MAEC One project and carries its DATABASE_URL and SESSION_SECRET.
# The two must not be merged: env_file: .env would inject another
# project's database credentials into this container.
#
#   cp .env.maec.example .env.maec && chmod 600 .env.maec
#
# Add `.env.maec` to .gitignore.

# --- sign-in gate ------------------------------------------------------
MAEC_EMAIL=engineering@mirageaec.com

# Must be set. Unset, the app falls back to the password committed in
# backend/auth.py and prints which one is in force at startup — check the
# logs after first boot.
MAEC_PASSWORD=change-me-before-first-deploy

# --- MANDATORY — the container refuses to start without this -----------
# Signs the session cookie. auth.py generates a random fallback when this
# is unset, and that fallback is evaluated PER PROCESS. With six workers
# that means six different signing keys, so roughly five requests in six
# fail cookie verification and the user is logged out at random. On the
# single-process Render deployment this only meant "logged out on
# restart"; under multi-worker it makes the app unusable.
#
# Generate once:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Rotating it signs everyone out — the emergency revoke switch.
MAEC_SECRET_KEY=generate-a-long-random-value

# --- tuning ------------------------------------------------------------
# WEB_CONCURRENCY is normally left UNSET. The entrypoint derives the worker
# count from the CPU actually available to the container: it reads the
# cgroup quota first (nproc reports the host's cores and ignores a Docker
# --cpus limit), then uses cores-1, with a floor of 1. So the same image is
# correct on a 2-core laptop and a 16-core box with no edit here.
#
# Set it only to override that deliberately. Worker PROCESSES, not threads:
# MuPDF holds the GIL, so threads measure ~1.0x while processes scale.
# Roughly 200 MB peak per concurrent parse.
#
# WEB_CONCURRENCY=4
# --- DO NOT SET IN PRODUCTION -----------------------------------------
# MAEC_DEV=1   # enables permissive CORS for the local Vite dev server only
