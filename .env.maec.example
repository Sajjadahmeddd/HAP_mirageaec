# MAEC (HAPExt / AirSizer / Rebadging) container configuration.
#
# Named .env.maec — NOT .env — because the repository root .env belongs to
# the MAEC One project and carries its DATABASE_URL and SESSION_SECRET.
# The two must not be merged: env_file: .env would inject another
# project's database credentials into this container.
#
#   cp .env.maec.example .env.maec && chmod 600 .env.maec
#
# Add `.env.maec` to .gitignore.

# --- MAEC One's gate — the container refuses to start without these --------
# Engineering Tools signs nobody in. On every request its backend asks MAEC One
# Core whether the browser's MAEC One cookie belongs to someone with a seat.
# See backend/maec_auth/README.md.

# Core as THIS SERVER reaches it: inside Docker, so the server-to-server check
# never leaves the machine. This stack joins Core's network (maec_core_net),
# where Core answers as maec-core.
CORE_URL=http://maec-core:8000

# Core as a BROWSER reaches it: where "Sign out" and the no-access page's link
# point. CORE_URL above is Docker-internal and no browser can open it.
CORE_PUBLIC_URL=https://auth.mirageaec.com

# This app's key in Core.
MAEC_APP_KEY=engineering

# This app's entry in Core's GATE_SECRETS (engineering=<secret>) — the SAME
# value. Generate it once, on the server, and put it in both places:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Never reuse one that has been pasted into a chat, a ticket or a commit.
MAEC_GATE_SECRET=generate-on-the-server

# --- docker-compose.yml, optional -------------------------------------------
# Every compose command passes --env-file .env.maec, so these are read from
# here too. Leave them unset: the compose file's defaults are the VPS's values.
# ET_PORT=8082                  # 8080 = the old stack, 8081 = Project Management
# ET_NET_SUBNET=10.231.2.0/24

# --- tuning ------------------------------------------------------------
# WEB_CONCURRENCY is normally left UNSET. The entrypoint derives the worker
# count from the CPU actually available to the container: it reads the
# cgroup quota first (nproc reports the host's cores and ignores a Docker
# --cpus limit), then uses cores-1, with a floor of 1. So the same image is
# correct on a 2-core laptop and a 16-core box with no edit here.
#
# Set it only to override that deliberately. Worker PROCESSES, not threads:
# MuPDF holds the GIL, so threads measure ~1.0x while processes scale.
# Roughly 200 MB peak per concurrent parse.
#
# WEB_CONCURRENCY=4
# --- DO NOT SET IN PRODUCTION -----------------------------------------
# MAEC_DEV=1   # enables permissive CORS for the local Vite dev server only
