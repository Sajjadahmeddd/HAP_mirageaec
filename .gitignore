# ---- Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# ---- Desktop build artifacts (regenerated: see build/build.md)
# PyInstaller writes both its work dir (build/<name>/) and the bundle
# (build/app/) here; only the build *inputs* belong in the repo.
*.spec
build/*
!build/build.md
!build/installer.iss
!build/app.ico
!build/portable_readme.txt
dist/

# ---- Web build artifacts
frontend/node_modules/
frontend/dist/

# ---- Generated output
output/

# ---- Never commit real secrets
.env
.env.*
!.env.example
