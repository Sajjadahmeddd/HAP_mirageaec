# Engineering Tools does NOT read this file. It is documentation.
#
# Every value comes from the environment — set it in the Render dashboard, or
# export it in the shell that starts uvicorn. There is no python-dotenv here
# on purpose: the one secret this service holds is its OIDC client secret, and
# a file that is read is a file that gets committed.
#
# With any of these missing, nobody can sign in and every API route refuses —
# the closed direction. On Render a missing value refuses the boot.
# See backend/maec_auth/README.md.

# MAEC One Core, the only host keys are ever fetched from.
OIDC_ISSUER=http://auth.maec.local:8000

# This product's registration in Core.
OIDC_CLIENT_ID=engineering-0bef07bb1d6703c4
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://et.maec.local:8080/auth/callback

# Signs this product's own et_session cookie. Any long random string.
ET_SESSION_SECRET=
