# Copy to .env for local use, or set these in the Render dashboard.
# .env is gitignored — never commit real values.

# Signing in is ALWAYS required, and there is no built-in password to fall
# back on: if MAEC_PASSWORD is unset, or shorter than 8 characters, the app
# refuses to start. Nothing here is a working credential — set your own.
MAEC_EMAIL=you@example.com
MAEC_PASSWORD=change-me-before-first-deploy

# Signs the session cookie. Render generates this automatically via
# render.yaml. Changing it signs everybody out.
MAEC_SECRET_KEY=
