# MAEC backend — FastAPI + PyMuPDF engine
# Build context is the REPO ROOT (see docker-compose.yml), because the
# engine packages live outside backend/.
FROM python:3.12-slim AS base

# Faster, quieter, no .pyc clutter in the image
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# ---- dependencies -----------------------------------------------------
# Copied alone first so this layer is cached until requirements.txt changes.
# PyMuPDF ships manylinux wheels, so no compiler is needed. If a future
# dependency needs to build from source, add build-essential here.
COPY backend/requirements.txt ./backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt

# ---- application ------------------------------------------------------
# Only what the server actually needs. .dockerignore keeps tests, sample
# PDFs and node_modules out of the build context entirely.
COPY backend/         ./backend/
COPY hap_converter/   ./hap_converter/
COPY airsizer/        ./airsizer/
COPY config/          ./config/

# Run as a non-root user. Uploads land in a writable temp dir that is
# wiped on every container restart, which suits the stateless design.
RUN useradd --create-home --uid 10001 maec \
 && mkdir -p /tmp/maec-uploads \
 && chown -R maec:maec /app /tmp/maec-uploads
USER maec

ENV TMPDIR=/tmp/maec-uploads \
    PORT=8000 \
    WEB_CONCURRENCY=6

EXPOSE 8000

# Python-only healthcheck so the image stays lean (no curl needed).
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/health',timeout=4).status==200 else 1)"

# uvicorn --workers rather than gunicorn: gunicorn's default 30 s worker
# timeout would kill a worker mid-parse on a large drawing set. Each worker
# is a separate process, which is the only concurrency that helps here —
# MuPDF holds the GIL, so threads give ~1.0x while processes scale.
CMD ["sh", "-c", "exec uvicorn backend.main:app --host 0.0.0.0 --port ${PORT} --workers ${WEB_CONCURRENCY} --timeout-keep-alive 75"]
