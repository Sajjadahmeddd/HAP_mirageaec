# Copy to .env for local use, or set these in the Render dashboard.
# .env is gitignored — never commit real values.

# Signing in is ALWAYS required. Leaving these unset does not open the app;
# it falls back to the built-in credentials in backend/auth.py, which are
# visible to anyone with repository access. Override both before sharing a
# public URL.
MAEC_EMAIL=mirageaec@mirage.com
MAEC_PASSWORD=hapext

# Signs the session cookie. Render generates this automatically via
# render.yaml. Changing it signs everybody out.
MAEC_SECRET_KEY=
