# ---- Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# ---- Desktop build artifacts (regenerated: see build/build.md)
# PyInstaller writes both its work dir (build/<name>/) and the bundle
# (build/app/) here; only the build *inputs* belong in the repo.
*.spec
build/*
!build/build.md
!build/installer.iss
!build/app.ico
!build/portable_readme.txt
dist/

# ---- Web build artifacts
frontend/node_modules/
frontend/dist/

# ---- Generated output
output/

# ---- Never commit real secrets
.env
.env.*
!.env.example
# The container stack reads .env.maec (the root .env belongs to MAEC One).
# The rule above hides .env.maec.example too, so re-include the template.
!.env.maec.example

# ---- Docker
# Compose auto-loads this whenever it exists. Keeping it out of git means
# a server clone cannot accidentally inherit laptop limits and port 8080.
docker-compose.override.yml

# ---- Incomplete asset transfers (re-save the source, don't commit a partial)
design-references/*TRUNCATED*
