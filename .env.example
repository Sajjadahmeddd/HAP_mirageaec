# Engineering Tools does NOT read this file. It is documentation.
#
# Every value comes from the environment — set it in the Render dashboard, or
# export it in the shell that starts uvicorn. There is no python-dotenv here
# on purpose: the one secret this service holds is its gate secret, and a file
# that is read is a file that gets committed.
#
# With any of these missing the service refuses to start.
# See backend/maec_auth/README.md.

# MAEC One Core, as this server reaches it.
CORE_URL=http://auth.maec.local:8000

# Optional: Core as a BROWSER reaches it, for "Sign out". Unset, CORE_URL.
# In the container CORE_URL is Docker-internal, so this is set there.
# CORE_PUBLIC_URL=https://auth.mirageaec.com

# This app's key in Core.
MAEC_APP_KEY=engineering

# This app's secret in Core's GATE_SECRETS (engineering=<secret>).
MAEC_GATE_SECRET=

# Optional: the socket peers whose X-Forwarded-Proto / X-Forwarded-Host are
# believed. Unset trusts nobody (right on a developer's machine). The
# container sets it to its nginx network's range.
# TRUSTED_PROXIES=172.30.81.0/24

# --- docker-compose.yml: running NEXT TO the old Engineering Tools ---------
# Compose reads these from a .env beside docker-compose.yml when present;
# the values below are the defaults written into the compose file itself.
# The old stack keeps 127.0.0.1:80, maec_maec_net and 172.30.57.0/24.
#
# The published port, on 127.0.0.1 only. Caddy's et.mirageaec.com block
# points here to go live (localhost:80 again to roll back).
# ET_PORT=8081
#
# This stack's internal network range. Must overlap neither 172.30.57.0/24
# (the old stack) nor Core's (172.31.250.0/24 by default). TRUSTED_PROXIES is
# built from it, so the two cannot drift.
# ET_NET_SUBNET=172.30.81.0/24
