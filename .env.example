# Copy to .env for local use, or set these in the Render dashboard.
# .env is gitignored — never commit real values.

# The team password. UNSET MEANS THE APP IS WIDE OPEN, which is fine locally
# but dangerous on a public Render URL. The service warns loudly at startup
# and /api/health reports "auth": "off" when it is missing.
MAEC_PASSWORD=change-me

# The address that pairs with it. Optional; defaults to hapext@mirageaec.com.
MAEC_EMAIL=hapext@mirageaec.com

# Signs the session cookie. Render generates this automatically via
# render.yaml. Changing it signs everybody out.
MAEC_SECRET_KEY=
