# Engineering Tools does NOT read this file. It is documentation.
#
# Every value comes from the environment — set it in the Render dashboard, or
# export it in the shell that starts uvicorn. There is no python-dotenv here
# on purpose: the one secret this service holds is its gate secret, and a file
# that is read is a file that gets committed.
#
# With any of these missing the service refuses to start.
# See backend/maec_auth/README.md.

# MAEC One Core, as this server reaches it.
CORE_URL=http://auth.maec.local:8000

# Optional: Core as a BROWSER reaches it, for "Sign out". Unset, CORE_URL.
# In the container CORE_URL is Docker-internal, so this is set there.
# CORE_PUBLIC_URL=https://auth.mirageaec.com

# This app's key in Core.
MAEC_APP_KEY=engineering

# This app's secret in Core's GATE_SECRETS (engineering=<secret>).
MAEC_GATE_SECRET=

# Optional: the socket peers whose X-Forwarded-Proto / X-Forwarded-Host are
# believed. Unset trusts nobody (right on a developer's machine). The
# container sets it to its nginx network's range.
# TRUSTED_PROXIES=10.231.2.0/24

# --- docker-compose.yml: running NEXT TO the old Engineering Tools ---------
# Every compose command passes --env-file .env.maec, so compose reads these
# from .env.maec when they are set there; the values below are the defaults
# written into the compose file itself, and need setting only to change them.
# On the VPS the old stack holds 127.0.0.1:8080 (project "maec") and Project
# Management 127.0.0.1:8081 (project "promanage").
#
# The published port, on 127.0.0.1 only. Caddy's engtools.mirageaec.com block
# points here (the old et.mirageaec.com block keeps pointing at 8080).
# ET_PORT=8082
#
# This stack's internal network range. Must overlap neither 172.30.57.0/24
# (the old stack) nor Core's 10.231.0.0/24 and 10.231.1.0/24. It sits beside
# Core's in 10.231.x, outside Docker's default address pools (172.17-31.x,
# 192.168.x), so no automatically created network can already hold it.
# TRUSTED_PROXIES is built from it, so the two cannot drift.
# ET_NET_SUBNET=10.231.2.0/24

# --- Every setting the live app reads, and where it went -------------------
# The live stack (origin/main) reads these from .env.maec, compose and the
# entrypoint. Names only; keep your own values.
#
# Carried over, same meaning (set them in .env.maec, as on live):
#
# Worker processes. Normally UNSET: the entrypoint uses the container's CPUs
# minus one (cgroup quota first), floor 1. Set only to override deliberately.
# WEB_CONCURRENCY=4
#
# Permissive CORS for the local Vite dev server only. The container refuses to
# start with it set. Never in production.
# MAEC_DEV=1
#
# PORT is set by docker-compose.yml (8000), exactly as on live.
#
# Retired with the shared-password sign-in — MAEC One Core signs people in now
# (CORE_URL, CORE_PUBLIC_URL, MAEC_APP_KEY, MAEC_GATE_SECRET above replace them):
#   MAEC_EMAIL, MAEC_PASSWORD   the shared account      -> each person's MAEC One account
#   MAEC_SECRET_KEY             signed the session cookie -> no session here; the cookie is Core's
#   MAEC_DISPLAY_NAME           the launcher's greeting  -> the launcher is Core's page
#
# Retired: RENDER. Live set RENDER=1 in compose only to keep HSTS on; HSTS now
# follows whether the request came over https (TRUSTED_PROXIES).
