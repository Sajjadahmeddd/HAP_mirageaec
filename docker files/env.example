# Copy to .env on the server and fill in real values.
#   cp .env.example .env && chmod 600 .env
# .env is gitignored and .dockerignored — secrets stay out of images and
# out of the repository.

# --- sign-in gate ------------------------------------------------------
MAEC_EMAIL=engineering@mirageaec.com

# Must be set. The app falls back to a password committed in
# backend/auth.py if this is missing, and prints which one is in force at
# startup — check the logs after first boot.
MAEC_PASSWORD=change-me-before-first-deploy

# Signs the session cookie. Generate once:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this signs everyone out — it is the emergency revoke switch.
MAEC_SECRET_KEY=generate-a-long-random-value

# --- tuning ------------------------------------------------------------
# Worker processes. Start at 6 on an 8-core box and watch CPU under a real
# batch. More workers = more concurrent PDF jobs, ~200 MB peak each.
WEB_CONCURRENCY=6

# --- DO NOT SET IN PRODUCTION -----------------------------------------
# MAEC_DEV=1   # enables permissive CORS for the local Vite dev server only
