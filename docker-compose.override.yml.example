# Laptop-sized overrides.  Copy to docker-compose.override.yml to use:
#
#     cp docker-compose.override.yml.example docker-compose.override.yml
#
# docker-compose.override.yml is gitignored ON PURPOSE. Compose loads it
# automatically whenever it is present, so a committed copy would follow the
# repository onto the VM and silently give production two workers on port
# 8080 the first time someone forgot `-f docker-compose.yml`. Keeping it out
# of git means the server clone simply has no override to forget about.
#
# With this in place:      http://localhost:8080   2 workers, 4 GB, 2 CPUs
# Without it (production): http://localhost        6 workers, 12 GB, 7 CPUs

services:
  backend:
    environment:
      # Two workers is enough to prove the multi-process path works — which
      # is what Gate 8 is checking — without pinning a development machine.
      # Overrides the value coming from .env.maec.
      WEB_CONCURRENCY: "2"
    deploy:
      resources:
        limits:
          cpus: "2.0"
          memory: 4g
    tmpfs:
      # 2g of RAM for uploads is a lot to give up on a laptop.
      - /tmp/maec-uploads:size=512m,mode=1777

  frontend:
    # `!override` REPLACES the base list. Without it Compose APPENDS to the
    # ports list, and you would end up publishing 80 and 8080 at once — with
    # 80 usually failing on a machine that already has something on it.
    ports: !override
      - "8080:80"
    deploy:
      resources:
        limits:
          cpus: "1.0"
          memory: 256m
